# Copy to .env and fill in. Loaded by `omnigo` at startup (missing file is
# ignored). Any variable already set in the real environment wins over this
# file, so container and systemd deploys can leave it out entirely.

# --- Core ---
# 32-byte key material for encrypting auth.yaml. Auto-generated into
# .secret.key when unset. Losing it means re-entering every credential.
# OMNIGO_SECRET_KEY=
#   alias: AIGO_SECRET_KEY

# Override the configuration root (default: ~/.config/omnigo).
# OMNIGO_CONFIG_DIR=

# --- Dashboard ---
# Required when dashboard.auth is on (the default). No built-in account.
# OMNIGO_DASH_USER=
# OMNIGO_DASH_PASS=
#   aliases: OMNIGO_DASHBOARD_USER, OMNIGO_DASHBOARD_PASS / _PASSWORD

# --- Smart routing ---
# System One key used by `smart` combos.
# TYPESAFE_API_KEY=

# --- Antigravity OAuth ---
# Public CLI defaults; override only for a self-hosted setup. The tokens
# themselves live encrypted in auth.yaml, not here.
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# --- Langfuse tracing ---
# Override the key pair saved in the dashboard Settings tab. Both must be set,
# or the stored pair is used instead.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
